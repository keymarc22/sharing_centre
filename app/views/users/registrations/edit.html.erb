<div class="dashboard-container">
  <div class="dashboard-layout" data-controller="sidebar">
    <div class="sidebar-overlay hidden" data-sidebar-target="overlay" data-action="click->sidebar#close"></div>
    <%= render Layout::SidebarComponent.new %>

    <div class="main-content">
      <%= render Layout::HeaderComponent.new %>

      <div class="p-6 max-w-2xl">
        <div class="section-header mb-6">
          <h2 class="text-2xl font-semibold">My Profile</h2>
        </div>

        <% if flash[:alert].present? %>
          <div class="login-alert login-alert--error mb-4" role="alert"><%= flash[:alert] %></div>
        <% end %>
        <% if flash[:notice].present? %>
          <div class="login-alert login-alert--notice mb-4" role="status"><%= flash[:notice] %></div>
        <% end %>

        <%= simple_form_for resource, as: resource_name, url: registration_path(resource_name), html: { method: :put } do |f| %>
          <%= render "users/shared/error_messages", resource: resource %>

          <div class="lessons-table-card p-6 mb-6">
            <h3 class="text-base font-semibold mb-4 text-slate-700">Personal information</h3>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <%= f.input :name, label: "Name", wrapper_html: { class: "flex flex-col gap-1.5 mb-0" } %>
              <%= f.input :email, label: "Email", wrapper_html: { class: "flex flex-col gap-1.5 mb-0" } %>
              <%= f.input :country_code,
                    as: :country,
                    label: "Country",
                    priority_countries: %w[MX US ES CO AR],
                    wrapper_html: { class: "flex flex-col gap-1.5 mb-0" } %>
              <%= f.input :phone, label: "Phone", required: false, wrapper_html: { class: "flex flex-col gap-1.5 mb-0" } %>
            </div>
          </div>

          <div class="lessons-table-card p-6 mb-6">
            <h3 class="text-base font-semibold mb-1 text-slate-700">Change password</h3>
            <p class="text-sm text-muted-foreground mb-4">Leave blank to keep your current password.</p>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <%= f.input :password,
                    label: "New password",
                    required: false,
                    hint: "#{@minimum_password_length} characters minimum",
                    input_html: { autocomplete: "new-password" },
                    wrapper_html: { class: "flex flex-col gap-1.5 mb-0" } %>
              <%= f.input :password_confirmation,
                    label: "Confirm new password",
                    required: false,
                    input_html: { autocomplete: "new-password" },
                    wrapper_html: { class: "flex flex-col gap-1.5 mb-0" } %>
            </div>
          </div>

          <div class="lessons-table-card p-6 mb-6">
            <h3 class="text-base font-semibold mb-1 text-slate-700">Confirm changes</h3>
            <p class="text-sm text-muted-foreground mb-4">Enter your current password to save any changes.</p>

            <%= f.input :current_password,
                  label: "Current password",
                  hint: false,
                  input_html: { autocomplete: "current-password" },
                  wrapper_html: { class: "flex flex-col gap-1.5" } %>
          </div>

          <div class="flex gap-3">
            <%= f.submit "Save changes",
                  class: "inline-flex items-center justify-center gap-2 rounded-md font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/80 h-9 px-4 text-sm cursor-pointer" %>
            <%= link_to "Cancel", :back,
                  class: "inline-flex items-center justify-center gap-2 rounded-md font-medium transition-colors border border-input bg-background hover:bg-accent h-9 px-4 text-sm" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
