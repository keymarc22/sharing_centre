<div class="dashboard-container">
  <div class="dashboard-layout" data-controller="sidebar">
    <div class="sidebar-overlay hidden" data-sidebar-target="overlay" data-action="click->sidebar#close"></div>
    <%= render Layout::SidebarComponent.new %>

    <div class="main-content">
      <%= render Layout::HeaderComponent.new %>

      <div class="p-6">
        <div class="section-header mb-4">
          <h2 class="text-2xl font-semibold">
            <%= current_user.admin? ? "All Classes" : "My Classes" %>
          </h2>
          <% if current_user.admin? || current_user.teacher? %>
            <%= link_to new_calendar_path, class: "inline-flex items-center gap-2 rounded-md font-medium bg-primary text-primary-foreground hover:bg-primary/80 h-9 px-4 text-sm" do %>
              <%= lucide_icon "plus", class: "w-4 h-4" %>
              <span class="hidden sm:inline">New Class</span>
            <% end %>
          <% end %>
        </div>

        <%# Filter tabs %>
        <div class="flex gap-1 mb-6 bg-slate-100 rounded-lg p-1 w-fit">
          <%= link_to classes_path(filter: 'upcoming'),
                class: "session-filter-tab #{@filter == 'upcoming' ? 'session-filter-tab--active' : ''}" do %>
            Upcoming
          <% end %>
          <%= link_to classes_path(filter: 'past'),
                class: "session-filter-tab #{@filter == 'past' ? 'session-filter-tab--active' : ''}" do %>
            Past
          <% end %>
        </div>

        <% if @sessions.any? %>
          <%# Desktop table — hidden on mobile %>
          <div class="lessons-table-card hidden md:block">
            <table class="lessons-table">
              <thead>
                <tr>
                  <th>Date &amp; Time</th>
                  <th>Class</th>
                  <% if current_user.admin? || current_user.student? %>
                    <th>Teacher</th>
                  <% end %>
                  <% if current_user.admin? || current_user.teacher? %>
                    <th>Student</th>
                    <th>Contact</th>
                  <% end %>
                  <th>Meet</th>
                </tr>
              </thead>
              <tbody>
                <% @sessions.each do |session| %>
                  <tr>
                    <td class="whitespace-nowrap">
                      <div class="font-medium text-sm"><%= session.start_at.strftime("%b %-d, %Y") %></div>
                      <div class="text-muted-foreground text-xs">
                        <%= session.start_at.strftime("%-I:%M %p") %> – <%= session.end_at.strftime("%-I:%M %p") %>
                      </div>
                    </td>
                    <td>
                      <div class="font-medium text-sm"><%= session.title %></div>
                      <% if session.recurring? %>
                        <span class="inline-flex items-center gap-1 text-xs text-slate-500">
                          <%= lucide_icon "repeat", class: "w-3 h-3" %>
                          Recurring
                        </span>
                      <% end %>
                    </td>
                    <% if current_user.admin? || current_user.student? %>
                      <td class="text-sm"><%= session.teacher&.name || "—" %></td>
                    <% end %>
                    <% if current_user.admin? || current_user.teacher? %>
                      <td class="text-sm"><%= session.student&.name || "—" %></td>
                      <td>
                        <% contact = session.student %>
                        <% if contact %>
                          <div class="text-sm text-muted-foreground"><%= contact.email %></div>
                          <% if contact.phone.present? %>
                            <div class="text-xs text-slate-400"><%= contact.phone %></div>
                          <% end %>
                        <% end %>
                      </td>
                    <% end %>
                    <td>
                      <% if session.meet_link.present? %>
                        <%= link_to session.meet_link, target: "_blank", rel: "noopener",
                              class: "inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-800 whitespace-nowrap" do %>
                          <%= lucide_icon "video", class: "w-4 h-4" %>
                          Join
                        <% end %>
                      <% else %>
                        <span class="text-muted-foreground text-sm">—</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <%# Mobile cards — visible only on small screens %>
          <div class="md:hidden space-y-3">
            <% @sessions.each do |session| %>
              <div class="session-card">
                <div class="session-card-header">
                  <div>
                    <div class="session-card-date">
                      <%= session.start_at.strftime("%b %-d, %Y") %>
                    </div>
                    <div class="session-card-time">
                      <%= session.start_at.strftime("%-I:%M %p") %> – <%= session.end_at.strftime("%-I:%M %p") %>
                    </div>
                  </div>
                  <% if session.recurring? %>
                    <span class="inline-flex items-center gap-1 text-xs text-slate-500 bg-slate-100 px-2 py-1 rounded-full">
                      <%= lucide_icon "repeat", class: "w-3 h-3" %>
                      Recurring
                    </span>
                  <% end %>
                </div>

                <div class="session-card-title"><%= session.title %></div>

                <div class="session-card-people">
                  <% if current_user.admin? || current_user.student? %>
                    <div class="session-card-person">
                      <%= lucide_icon "user", class: "w-3.5 h-3.5 text-slate-400 shrink-0" %>
                      <span class="text-xs text-slate-600"><%= session.teacher&.name || "—" %></span>
                    </div>
                  <% end %>
                  <% if current_user.admin? || current_user.teacher? %>
                    <div class="session-card-person">
                      <%= lucide_icon "user", class: "w-3.5 h-3.5 text-slate-400 shrink-0" %>
                      <span class="text-xs text-slate-600"><%= session.student&.name || "—" %></span>
                    </div>
                    <% contact = session.student %>
                    <% if contact&.email.present? %>
                      <div class="session-card-person">
                        <%= lucide_icon "mail", class: "w-3.5 h-3.5 text-slate-400 shrink-0" %>
                        <span class="text-xs text-slate-600"><%= contact.email %></span>
                      </div>
                    <% end %>
                    <% if contact&.phone.present? %>
                      <div class="session-card-person">
                        <%= lucide_icon "phone", class: "w-3.5 h-3.5 text-slate-400 shrink-0" %>
                        <span class="text-xs text-slate-600"><%= contact.phone %></span>
                      </div>
                    <% end %>
                  <% end %>
                </div>

                <% if session.meet_link.present? %>
                  <div class="session-card-footer">
                    <%= link_to session.meet_link, target: "_blank", rel: "noopener",
                          class: "inline-flex items-center gap-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-md px-3 py-1.5" do %>
                      <%= lucide_icon "video", class: "w-4 h-4" %>
                      Join Meet
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

        <% else %>
          <div class="flex flex-col items-center justify-center py-16 text-center text-muted-foreground">
            <%= lucide_icon "calendar-x-2", class: "w-12 h-12 mb-4 opacity-30" %>
            <p class="text-lg font-medium">
              <%= @filter == 'upcoming' ? 'No upcoming classes' : 'No past classes' %>
            </p>
            <% if (current_user.admin? || current_user.teacher?) && @filter == 'upcoming' %>
              <p class="text-sm mt-1">
                <%= link_to "Schedule a class", new_calendar_path, class: "text-blue-600 hover:underline" %>
                to get started.
              </p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%= render Layout::RightSidebarComponent.new %>
  </div>
</div>
