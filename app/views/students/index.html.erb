<div class="dashboard-container">
  <div class="dashboard-layout" data-controller="sidebar">
    <div class="sidebar-overlay hidden" data-sidebar-target="overlay" data-action="click->sidebar#close"></div>
    <%= render Layout::SidebarComponent.new %>

    <div class="main-content">
      <%= render Layout::HeaderComponent.new %>

      <div class="p-6">
        <div class="section-header mb-6">
          <h2 class="text-2xl font-semibold">
            <%= current_user.admin? ? "All Students" : "My Students" %>
          </h2>
        </div>

        <% if @students.any? %>
          <%# Desktop table %>
          <div class="lessons-table-card hidden md:block">
            <table class="lessons-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Language Level</th>
                  <th>Country</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @students.each do |student| %>
                  <tr>
                    <td class="class-cell font-medium"><%= student.name %></td>
                    <td class="text-muted-foreground"><%= student.email %></td>
                    <td>
                      <% level = student.custom_data&.dig('current_language_level') %>
                      <% if level.present? %>
                        <span class="payment-badge payment-done"><%= level %></span>
                      <% else %>
                        <span class="text-muted-foreground text-sm">—</span>
                      <% end %>
                    </td>
                    <td><%= student.country_code&.upcase || "—" %></td>
                    <td>
                      <%= link_to student_path(student), class: "inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-800" do %>
                        <%= lucide_icon "eye", class: "w-4 h-4" %>
                        View
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <%# Mobile cards %>
          <div class="md:hidden space-y-3">
            <% @students.each do |student| %>
              <% level = student.custom_data&.dig('current_language_level') %>
              <div class="person-card">
                <div class="person-card-avatar"><%= student.name&.first&.upcase %></div>
                <div class="person-card-info">
                  <div class="person-card-name"><%= student.name %></div>
                  <div class="person-card-email"><%= student.email %></div>
                  <div class="person-card-meta">
                    <% if level.present? %>
                      <span class="payment-badge payment-done"><%= level %></span>
                    <% end %>
                    <% if student.country_code.present? %>
                      <span class="text-slate-400 text-xs"><%= student.country_code.upcase %></span>
                    <% end %>
                  </div>
                </div>
                <div class="person-card-action">
                  <%= link_to student_path(student), class: "inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-800" do %>
                    <%= lucide_icon "eye", class: "w-4 h-4" %>
                    <span class="sr-only">View</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="flex flex-col items-center justify-center py-16 text-center text-muted-foreground">
            <%= lucide_icon "users", class: "w-12 h-12 mb-4 opacity-30" %>
            <p class="text-lg font-medium">No students yet</p>
            <% if current_user.admin? %>
              <p class="text-sm mt-1">Add students to get started.</p>
            <% else %>
              <p class="text-sm mt-1">You have no students enrolled in your classes yet.</p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%= render Layout::RightSidebarComponent.new %>
  </div>
</div>
