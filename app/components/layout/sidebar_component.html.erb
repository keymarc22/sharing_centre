<div class="sidebar" data-sidebar-target="panel">
  <div class="sidebar-content">
    <!-- logo_container -->
    <div class="logo-container">
      <div class="logo-icon">
        <%= image_tag "isotipo.png", alt: "Sharing Centre Logo" %>
        <span class="logo-text">Sharing Centre</span>
      </div>
    </div>

    <nav class="sidebar-nav">
      <% items.each do |item| %>
        <%= render Layout::SidebarItemComponent.new(item:) %>
      <% end %>
    </nav>

    <div class="sidebar-footer">
      <div class="sidebar-user-card">
        <div class="sidebar-user-avatar">
          <%= current_user.name.first.upcase %>
        </div>
        <div class="sidebar-user-info">
          <span class="sidebar-user-name"><%= current_user.name %></span>
          <span class="sidebar-user-email"><%= current_user.email %></span>
        </div>
      </div>

      <ul>
        <li>
          <%= link_to edit_user_registration_path, class: 'nav-item' do %>
            <%= lucide_icon "user-pen" %>
            <span><%= t('.edit_profile') %></span>
          <% end %>
        </li>
        <li>
          <%= button_to destroy_user_session_path, class: 'nav-item', method: :delete, data: { turbo: false } do %>
            <%= lucide_icon "log-out" %>
            <span><%= t('.logout')%></span>
          <% end %>
        </li>
      </ul>
    </div>
  </div>
</div>